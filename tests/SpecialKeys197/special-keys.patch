+"""Game Bar uses delegated input; foreground HWND alone cannot detect it."""
+import ctypes,json,os
+from ctypes import wintypes
+from pathlib import Path
+
+def active():
+    try:
+        p = Path(os.environ['LOCALAPPDATA']) / 'Packages/ClawToolbox.GameBarWidget_ba3r68zr466za/LocalState/power-visibility.json'
+        data = json.loads(p.read_text(encoding='utf-8-sig'))
+        if data.get('foreground') is not True:
+            return False
+        kernel = ctypes.WinDLL('kernel32', use_last_error=True)
+        kernel.OpenProcess.restype = wintypes.HANDLE
+        kernel.CloseHandle.argtypes = [wintypes.HANDLE]
+        kernel.GetExitCodeProcess.argtypes = [wintypes.HANDLE, ctypes.POINTER(wintypes.DWORD)]
+        process = kernel.OpenProcess(4096, False, int(data['pid']))
+        if not process:
+            return False
+        try:
+            code = wintypes.DWORD()
+            return bool(kernel.GetExitCodeProcess(process, ctypes.byref(code))) and code.value == 259
+        finally:
+            kernel.CloseHandle(process)
+    except (OSError, ValueError, KeyError, TypeError):
+        return False
