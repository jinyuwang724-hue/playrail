<Page
    x:Class="ClawWidget.WidgetPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
    <Page.Resources>
        <ControlTemplate x:Key="QamThumb" TargetType="Thumb">
            <Grid>
                <Ellipse Fill="{TemplateBinding Foreground}" Opacity="0.18"/>
                <Ellipse Width="16" Height="16" Fill="{TemplateBinding Background}" Stroke="#F4F4F5" StrokeThickness="2.5"/>
                <Ellipse Width="19" Height="19" Fill="{TemplateBinding Foreground}"/>
            </Grid>
        </ControlTemplate>
        <Style x:Key="QamSlider" TargetType="Slider">
            <Setter Property="Background" Value="#25282C"/>
            <Setter Property="Foreground" Value="Transparent"/>
            <Setter Property="UseSystemFocusVisuals" Value="False"/>
            <Setter Property="IsFocusEngagementEnabled" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid x:Name="SliderContainer" Background="Transparent" Control.IsTemplateFocusTarget="True">
                            <Grid x:Name="HorizontalTemplate">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Rectangle x:Name="HorizontalTrackRect" Grid.ColumnSpan="3" Height="3" RadiusX="1.5" RadiusY="1.5" Fill="#38F4F4F5"/>
                                <Rectangle x:Name="HorizontalDecreaseRect" Height="3" Fill="#CFF4F4F5"/>
                                <Thumb x:Name="HorizontalThumb" Grid.Column="1" Width="24" Height="24" Template="{StaticResource QamThumb}" Background="{TemplateBinding Background}" Foreground="{TemplateBinding Foreground}" AutomationProperties.AccessibilityView="Raw"/>
                            </Grid>
                            <Grid x:Name="VerticalTemplate" Width="32">
                                <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <Rectangle x:Name="VerticalTrackRect" Grid.RowSpan="3" Width="3" RadiusX="1.5" RadiusY="1.5" Fill="#38F4F4F5"/>
                                <Rectangle x:Name="VerticalDecreaseRect" Grid.Row="2" Width="3" Fill="#CFF4F4F5"/>
                                <Thumb x:Name="VerticalThumb" Grid.Row="1" Width="24" Height="24" Template="{StaticResource QamThumb}" Background="{TemplateBinding Background}" Foreground="{TemplateBinding Foreground}" AutomationProperties.AccessibilityView="Raw"/>
                            </Grid>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Magpie / 小黄鸭 pages: one settings card per row (WinUI SettingsCard look). -->
        <Style x:Key="ScalingRow" TargetType="Button">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="MinHeight" Value="{StaticResource ScalingRowHeight}" />
            <Setter Property="Padding" Value="{StaticResource ScalingRowInset}" />
            <Setter Property="CornerRadius" Value="{StaticResource RadiusOuter}" />
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="UseSystemFocusVisuals" Value="False" />
        </Style>
    </Page.Resources>
    <!-- Native layout of the approved design ("UI design", WinUI Fluent dark): side rail, header with
         readings, 3 columns x 4 rows of quick tiles; tiles and their contents are built in WidgetPage.cpp. -->
    <!-- Game Bar's title bar already sits right above; only a small gap under it. -->
    <Grid x:Name="Root" Padding="12,4,12,12" ColumnSpacing="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Side rail: edit, brightness, volume, power -->
        <Border x:Name="Rail" Width="48" CornerRadius="4" Padding="0,4"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
            <Grid RowSpacing="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Button x:Name="EditButton" Grid.Row="0" Width="40" Height="44" Padding="0" HorizontalAlignment="Center"
                        Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="编辑磁贴" />
                <Rectangle Grid.Row="1" Width="32" Height="1" Margin="0,6" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                <Grid Grid.Row="2" RowSpacing="4">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <TextBlock x:Name="BrightnessValue" HorizontalAlignment="Center" FontWeight="SemiBold" Text="--" />
                    <Slider x:Name="BrightnessSlider" Style="{StaticResource QamSlider}" Grid.Row="1" Orientation="Vertical" HorizontalAlignment="Center" Minimum="0" Maximum="100"
                            SmallChange="1" LargeChange="1" StepFrequency="1" IsThumbToolTipEnabled="False" AutomationProperties.Name="亮度" ToolTipService.ToolTip="按 A 调节亮度" />
                    <Button x:Name="AutoBrightness" Grid.Row="2" Width="40" Height="36" Padding="0" HorizontalAlignment="Center"
                            Background="Transparent" BorderThickness="0" IsEnabled="False" />
                </Grid>
                <Rectangle Grid.Row="3" Width="32" Height="1" Margin="0,6" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                <Grid Grid.Row="4" RowSpacing="4">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <TextBlock x:Name="VolumeValue" HorizontalAlignment="Center" FontWeight="SemiBold" Text="--" />
                    <Slider x:Name="VolumeSlider" Style="{StaticResource QamSlider}" Grid.Row="1" Orientation="Vertical" HorizontalAlignment="Center" Minimum="0" Maximum="100"
                            SmallChange="1" LargeChange="1" StepFrequency="1" IsThumbToolTipEnabled="False" AutomationProperties.Name="音量" ToolTipService.ToolTip="按 A 调节音量" />
                    <Button x:Name="MuteButton" Grid.Row="2" Width="40" Height="36" Padding="0" HorizontalAlignment="Center"
                            Background="Transparent" BorderThickness="0" />
                </Grid>
                <Rectangle Grid.Row="5" Width="32" Height="1" Margin="0,6" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                <Button x:Name="PowerButton" Grid.Row="6" Width="40" Height="44" Padding="0" HorizontalAlignment="Center">
                    <Button.Flyout>
                        <MenuFlyout x:Name="PowerMenu" Placement="RightEdgeAlignedBottom">
                            <MenuFlyoutItem x:Name="SleepItem" Text="睡眠" />
                            <MenuFlyoutItem x:Name="ShutdownItem" Text="关机" />
                            <MenuFlyoutItem x:Name="RestartItem" Text="重启" />
                            <MenuFlyoutItem x:Name="PowerPreviewItem" Text="动画预览" />
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem x:Name="LockItem" Text="锁定" />
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
            </Grid>
        </Border>

        <!-- Quick tiles page -->
        <Grid x:Name="MainPanel" Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <!-- Collapsed while no banner shows, so the header lines up with the top of the rail. -->
            <StackPanel x:Name="Banners" Spacing="12" Margin="0,0,0,12" Visibility="Collapsed">
                <muxc:InfoBar x:Name="OfflineBar" IsClosable="False" Severity="Error" Title="未连接" Message="工具箱后台没有运行">
                    <muxc:InfoBar.ActionButton><Button x:Name="ReconnectButton" Content="重新连接" Style="{ThemeResource AccentButtonStyle}" /></muxc:InfoBar.ActionButton>
                </muxc:InfoBar>
                <muxc:InfoBar x:Name="ConflictBar" IsClosable="False" Severity="Warning" Title="功耗冲突" Message="体感助手也在设置功耗，两边会互相改写" />
                <muxc:InfoBar x:Name="MessageBar" IsClosable="False" Severity="Warning" />
            </StackPanel>
            <Border x:Name="Header" Grid.Row="1" CornerRadius="4" Padding="14,10" Margin="0,0,0,12"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <Grid Height="72">
                        <StackPanel x:Name="PowerLabel" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top" Margin="0,6,0,0">
                            <TextBlock Text="功耗" FontSize="15" FontWeight="SemiBold" Foreground="#99F4F4F5"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right" VerticalAlignment="Top">
                            <TextBlock x:Name="PowerSetpoint" Text="--" FontSize="40" FontWeight="Bold"/>
                            <TextBlock Text="W" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,6" VerticalAlignment="Bottom" Foreground="#99F4F4F5"/>
                        </StackPanel>
                        <TextBlock x:Name="PowerActual" Text="实际 -- W  ·  -- °C" Margin="26,29,0,0" FontSize="13" Foreground="#B3F4F4F5"/>
                        <Slider x:Name="PowerSlider" Style="{StaticResource QamSlider}" Height="24" VerticalAlignment="Bottom" Minimum="8" Maximum="35" SmallChange="1" LargeChange="1" StepFrequency="1" IsThumbToolTipEnabled="False" AutomationProperties.Name="功耗上限" ToolTipService.ToolTip="左右键，每次 1 W"/>
                        <Canvas x:Name="PowerTicks" Height="9" VerticalAlignment="Bottom" Margin="0,0,0,7.5" IsHitTestVisible="False"/>
                    </Grid>
            </Border>
            <Grid x:Name="QuickShortcuts" Grid.Row="2" RowSpacing="8" ColumnSpacing="8" Margin="0,0,0,12" XYFocusKeyboardNavigation="Enabled" />
            <Grid x:Name="Tiles" Grid.Row="3" RowSpacing="8" ColumnSpacing="8" XYFocusKeyboardNavigation="Enabled" />
        </Grid>

        <!-- Magpie / 小黄鸭: header + one column of setting rows, built in WidgetPage.cpp (ScalingRows). -->
        <Grid x:Name="ScalingPanel" Grid.ColumnSpan="2" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid Height="{StaticResource ScalingHeaderHeight}" ColumnSpacing="{StaticResource SpaceS}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button x:Name="ScalingBack" Width="{StaticResource ScalingBackSize}" Height="{StaticResource ScalingBackSize}" Padding="0"
                        Background="Transparent" BorderThickness="0" VerticalAlignment="Center" AutomationProperties.Name="返回快捷面板" />
                <TextBlock x:Name="ScalingTitle" Grid.Column="1" VerticalAlignment="Center" FontSize="{StaticResource TypeTitleSize}" FontWeight="SemiBold" />
                <TextBlock x:Name="ScalingGame" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis"
                           FontSize="{StaticResource TypeLabelSize}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </Grid>
            <ScrollViewer x:Name="ScalingScroll" Grid.Row="1" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Hidden" ZoomMode="Disabled" IsTabStop="False" XYFocusKeyboardNavigation="Enabled">
                <StackPanel x:Name="ScalingList" Spacing="{StaticResource SpaceXS}" XYFocusKeyboardNavigation="Enabled" />
            </ScrollViewer>
        </Grid>
        <!-- Tile editing -->
        <ScrollViewer x:Name="EditPanel" Grid.Column="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="12" Padding="0,0,10,0">
                <Grid MinHeight="48">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock FontSize="20" LineHeight="28" FontWeight="SemiBold" Text="编辑快捷磁贴" />
                        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="X 拿起 · 方向键移动 · X 放下" />
                    </StackPanel>
                    <Button x:Name="DoneButton" HorizontalAlignment="Right" Height="40" Padding="20,0" FontWeight="SemiBold"
                            Style="{ThemeResource AccentButtonStyle}" Content="完成" />
                </Grid>
                <Grid><TextBlock FontWeight="SemiBold" Text="已固定" /><TextBlock x:Name="PinnedCount" HorizontalAlignment="Right" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /></Grid>
                <Grid x:Name="PinnedTiles" RowSpacing="8" ColumnSpacing="8" Padding="0,8,8,0" />
                <Grid x:Name="AvailableHeader"><TextBlock FontWeight="SemiBold" Text="可添加" /><TextBlock x:Name="AvailableHint" HorizontalAlignment="Right" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="按 A 固定" /></Grid>
                <Grid x:Name="AvailableTiles" RowSpacing="8" ColumnSpacing="8" Padding="0,8,8,0" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
