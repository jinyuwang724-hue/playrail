@@ -446,6 +446,17 @@
     try:
         if updating():
             return 0
+        # The scheduled task starts us BELOW_NORMAL (task priority 7) and every helper inherits it, so a
+        # full-load game starves power control (save_power took 80-300 s). Run at NORMAL before any child starts.
+        try:
+            import ctypes
+            kernel32 = ctypes.WinDLL("kernel32", use_last_error=True)
+            kernel32.GetCurrentProcess.restype = ctypes.c_void_p
+            kernel32.SetPriorityClass.argtypes = (ctypes.c_void_p, ctypes.c_uint32)
+            if not kernel32.SetPriorityClass(kernel32.GetCurrentProcess(), 0x20):
+                logging.warning("SetPriorityClass failed: %d", ctypes.get_last_error())
+        except Exception:
+            logging.exception("Could not raise agent priority")
         if migrate():
             logging.info("Copied settings from %s", LEGACY_DATA)
         asyncio.run(run())
