{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "Cocoon Design System — platform-agnostic W3C Design Tokens (extracted from Playrail 0.1.331.15 reference implementation, logical canvas 1920x1200, 1 dp = 1.75 design px).",
  "meta": {
    "version": { "$type": "string", "$value": "1.0.0-draft" },
    "referenceCanvas": {
      "width": { "$type": "dimension", "$value": "1920px" },
      "height": { "$type": "dimension", "$value": "1200px" },
      "dpToDesignPx": { "$type": "number", "$value": 1.75, "$description": "1 dp equals 1.75 logical px on the 1920x1200 reference canvas (~1.0 CSS px at 1097x686 or 1.75px at 1920x1200)." }
    }
  },
  "color": {
    "brand": {
      "accentStart": { "$type": "color", "$value": "#86A7FD", "$description": "Focus & active gradient start (periwinkle blue, RwC1)." },
      "accentEnd": { "$type": "color", "$value": "#8037FF", "$description": "Focus & active gradient end (vivid violet, RwC2)." },
      "accentInk": { "$type": "color", "$value": "#7A4CFF", "$description": "Selected nav text/icon & accent dot (CpAccentInk)." },
      "accentDeep": { "$type": "color", "$value": "#7340FF", "$description": "Slider active fill & circular tile gradient end (SpOn2)." },
      "accentSoftStart": { "$type": "color", "$value": "#8F8BFF", "$description": "Circular tile active gradient start (SpOn1)." },
      "pillActionStart": { "$type": "color", "$value": "#8A7BFF", "$description": "Primary action capsule (Y ✓ / Y ▶) gradient start." },
      "pillActionEnd": { "$type": "color", "$value": "#7A3CFF", "$description": "Primary action capsule gradient end & glow color." },
      "pillBadgeLight": { "$type": "color", "$value": "#B9A9FF", "$description": "Keycap circle inside primary purple capsule." },
      "knobStart": { "$type": "color", "$value": "#9A9CFF", "$description": "Slider thumb gradient top-left." },
      "knobEnd": { "$type": "color", "$value": "#6F3CFF", "$description": "Slider thumb gradient bottom-right." },
      "selectionTint": { "$type": "color", "$value": "#ECE6FF", "$description": "Multi-select dropdown focused row background." },
      "activeCardTint": { "$type": "color", "$value": "#A596FF96", "$description": "Running/active cover card translucent lavender overlay (alpha 150/255)." }
    },
    "semantic": {
      "danger": { "$type": "color", "$value": "#F24B5A", "$description": "Destructive action text/icon (RmRed)." },
      "dangerStart": { "$type": "color", "$value": "#FF7A84", "$description": "Destructive icon gradient top." },
      "dangerBadge": { "$type": "color", "$value": "#F2566E", "$description": "Corner close/running badge fill (RqBadge)." },
      "confirmStart": { "$type": "color", "$value": "#72E096", "$description": "Primary confirm button gradient start (RqGreenA)." },
      "confirmEnd": { "$type": "color", "$value": "#0ECBAA", "$description": "Primary confirm button gradient end (RqGreenB)." },
      "selectedOption": { "$type": "color", "$value": "#4F9DF2", "$description": "Currently selected item ink inside single-select dropdown." },
      "wifiOnStart": { "$type": "color", "$value": "#8CC9F9" },
      "wifiOnEnd": { "$type": "color", "$value": "#5BA3FF" },
      "batteryNormalStart": { "$type": "color", "$value": "#7CD98A" },
      "batteryNormalEnd": { "$type": "color", "$value": "#0FD0B5" },
      "batteryChargeStart": { "$type": "color", "$value": "#FFC09C" },
      "batteryChargeEnd": { "$type": "color", "$value": "#FF8A28" }
    },
    "neutral": {
      "inkPrimary": { "$type": "color", "$value": "#1E1E24", "$description": "Primary text & solid icon ink on light surfaces (RmInk)." },
      "inkStrong": { "$type": "color", "$value": "#212121", "$description": "High-contrast dark ink on light capsules (RwInk)." },
      "inkTile": { "$type": "color", "$value": "#2A2A31", "$description": "Inactive circular tile icon ink (SpTileInk)." },
      "inkSecondary": { "$type": "color", "$value": "#5F6168", "$description": "Secondary captions, descriptions, and right-aligned values (RsSub)." },
      "inkMuted": { "$type": "color", "$value": "#5D5D68", "$description": "Muted caption in compact side panels (SpMute)." },
      "inkSubtle": { "$type": "color", "$value": "#8E9098", "$description": "Subtle chevrons and trailing indicators (LsGrey)." },
      "inkPlaceholder": { "$type": "color", "$value": "#9A9CA3", "$description": "Placeholder text, off-toggle border, keycap badge circle." },
      "inkDisabled": { "$type": "color", "$value": "#A8AAB0", "$description": "Disabled icons/arrows inside controls." },
      "inkOnDark": { "$type": "color", "$value": "#FAFAFA", "$description": "Primary white ink on dark/colored surfaces (RwWhite)." },
      "pureWhite": { "$type": "color", "$value": "#FFFFFF" }
    },
    "surface": {
      "pageTop": { "$type": "color", "$value": "#EFEFF4", "$description": "Full-screen Cocoon page background vertical gradient top." },
      "pageBottom": { "$type": "color", "$value": "#E2E3EA", "$description": "Full-screen Cocoon page background vertical gradient bottom." },
      "sheet": { "$type": "color", "$value": "#FAFAFA", "$description": "Modal sheet and context menu base background (RsBg)." },
      "drawerTop": { "$type": "color", "$value": "#FAFAFA", "$description": "Side drawer gradient stop 0%." },
      "drawerMid": { "$type": "color", "$value": "#F6F7FA", "$description": "Side drawer gradient stop ~33-60%." },
      "drawerLow": { "$type": "color", "$value": "#F2F6FA", "$description": "Side drawer gradient stop ~85-99%." },
      "drawerBottomEdge": { "$type": "color", "$value": "#E7EAF1", "$description": "Side drawer bottom edge shading stop 100%." },
      "card3dTop": { "$type": "color", "$value": "#FDFDFE", "$description": "3D elevated container fill gradient top (CpCard)." },
      "card3dBottom": { "$type": "color", "$value": "#F0F1F4", "$description": "3D elevated container fill gradient bottom (CpCard)." },
      "card3dEdgeTop": { "$type": "color", "$value": "#F4F4F7", "$description": "3D card 1.5px stroke gradient top." },
      "card3dEdgeBottom": { "$type": "color", "$value": "#C4C5CC", "$description": "3D card 1.5px stroke gradient bottom." },
      "card3dInnerShade": { "$type": "color", "$value": "#14142810", "$description": "3D card bottom 22px inner shadow (rgba 20,20,40, 16/255)." },
      "groupCard": { "$type": "color", "$value": "#F7F8FA", "$description": "Modal sheet grouped card fill (RsGroup)." },
      "groupEdgeTop": { "$type": "color", "$value": "#E8E9EC", "$description": "Modal sheet group card stroke top." },
      "groupEdgeBottom": { "$type": "color", "$value": "#BCBDC1", "$description": "Modal sheet group card stroke bottom." },
      "optionCard": { "$type": "color", "$value": "#FCFCFD", "$description": "Expanded dropdown menu card & secondary button fill." },
      "pillWhite": { "$type": "color", "$value": "#FFFFFF", "$description": "Dropdown trigger pill fill." },
      "pillBorder": { "$type": "color", "$value": "#ECEDF0", "$description": "Dropdown trigger pill 1px border." },
      "tileWell": { "$type": "color", "$value": "#F0F0F5", "$description": "Recessed tile container & metric chip fill (CpTile)." },
      "track": { "$type": "color", "$value": "#E4E4EC", "$description": "Gauge ring track fill (CpTrack)." },
      "sliderTrack": { "$type": "color", "$value": "#DCDCE3", "$description": "Linear slider track fill." },
      "barTrack": { "$type": "color", "$value": "#E6E6EE", "$description": "Activity bar empty track." },
      "toggleOff": { "$type": "color", "$value": "#E4E5E9", "$description": "Off-state toggle & expanded order capsule fill." },
      "tileOff": { "$type": "color", "$value": "#F5F6F9", "$description": "Off-state circular tile in side drawer." },
      "stepperPill": { "$type": "color", "$value": "#E6E7EC", "$description": "Stepper capsule (− value +) background." },
      "backPill": { "$type": "color", "$value": "#E2E3E7", "$description": "Back capsule (B ←) background." },
      "dividerGroove": { "$type": "color", "$value": "#E1E2E7", "$description": "3D card recessed divider top line (2.5px, paired with 1.5px #FFFFFF below)." },
      "dividerLine": { "$type": "color", "$value": "#E2E3E5", "$description": "Modal sheet group divider (4px, RsLine)." },
      "dividerSubtle": { "$type": "color", "$value": "#E6E7EA", "$description": "Dropdown option & drawer row separator (2px, LsSep)." },
      "pressOverlay": { "$type": "color", "$value": "#1E1E3C12", "$description": "Touch row press highlight (rgba 30,30,60, 18/255)." }
    },
    "scrim": {
      "modal": { "$type": "color", "$value": "#232325C2", "$description": "Menu / sheet / dialog backdrop scrim: rgba(35,35,37, 0.76), lifts shadows & flattens contrast without blurring wallpaper." },
      "drawer": { "$type": "color", "$value": "#18181C8C", "$description": "Left control drawer backdrop scrim: rgba(24,24,28, 0.55)." },
      "wallpaperFallback": { "$type": "color", "$value": "#1B1B22" },
      "focusRim": { "$type": "color", "$value": "#FAFAFA66", "$description": "Focus bracket outer white rim highlight (40% alpha)." }
    }
  },
  "typography": {
    "fontFamily": {
      "latin": { "$type": "fontFamily", "$value": ["Poppins", "Segoe UI Variable Display", "Inter", "system-ui", "sans-serif"] },
      "cjk": { "$type": "fontFamily", "$value": ["PingFang SC", "Microsoft YaHei UI", "Noto Sans CJK SC", "sans-serif"] }
    },
    "fontWeight": {
      "latinBody": { "$type": "fontWeight", "$value": 500 },
      "latinTitle": { "$type": "fontWeight", "$value": 600 },
      "latinBadge": { "$type": "fontWeight", "$value": 700 },
      "latinDisplay": { "$type": "fontWeight", "$value": 800 },
      "cjkStandard": { "$type": "fontWeight", "$value": 500, "$description": "CRITICAL: CJK text MUST stay at Medium (500), never 600, to prevent synthetic bold muddiness on high-contrast light surfaces." },
      "cjkBodyLight": { "$type": "fontWeight", "$value": 400 }
    },
    "scale": {
      "$description": "Values in logical design px (1920x1200). Divide by 1.75 for dp / mobile-scaled CSS px.",
      "pageTitle": { "$type": "dimension", "$value": "48px" },
      "fieldValue": { "$type": "dimension", "$value": "40px" },
      "rowTitleSheet": { "$type": "dimension", "$value": "38px" },
      "navLabel": { "$type": "dimension", "$value": "38px" },
      "rowTitle": { "$type": "dimension", "$value": "36px" },
      "dropdownOptionSheet": { "$type": "dimension", "$value": "36px" },
      "dialogBody": { "$type": "dimension", "$value": "36px" },
      "rowValue": { "$type": "dimension", "$value": "32px" },
      "dropdownOption": { "$type": "dimension", "$value": "32px" },
      "toast": { "$type": "dimension", "$value": "30px" },
      "gaugeCaption": { "$type": "dimension", "$value": "30px" },
      "sliderValue": { "$type": "dimension", "$value": "30px" },
      "drawerTitle": { "$type": "dimension", "$value": "28px" },
      "chipValue": { "$type": "dimension", "$value": "27px" },
      "rowSubSheet": { "$type": "dimension", "$value": "27px" },
      "rowSub": { "$type": "dimension", "$value": "26px" },
      "chipLabel": { "$type": "dimension", "$value": "25px" },
      "drawerPill": { "$type": "dimension", "$value": "24px" },
      "keycap": { "$type": "dimension", "$value": "22px" }
    }
  },
  "radius": {
    "sheet": { "$type": "dimension", "$value": "64px", "$description": "Full modal sheet corner radius (RsR)." },
    "dialog": { "$type": "dimension", "$value": "60px", "$description": "Confirm/quit dialog card radius." },
    "coverRatio": { "$type": "number", "$value": 0.17391305, "$description": "Cover art corner radius = cardWidth * 0.17391305 (e.g. 48.7px on 280px card)." },
    "menuCard": { "$type": "dimension", "$value": "40px", "$description": "Context menu card radius (RmCardR)." },
    "drawer": { "$type": "dimension", "$value": "36px", "$description": "Right side drawer & top frosted capsule radius (SpRad)." },
    "leftDrawer": { "$type": "dimension", "$value": "30px", "$description": "Left control drawer right-side corner radius (LsRad)." },
    "card": { "$type": "dimension", "$value": "30px", "$description": "Standard 3D group card & option card radius (CpCard / RsGroupR)." },
    "tileWell": { "$type": "dimension", "$value": "26px", "$description": "Inner chart well inside readout cards." },
    "optionFocus": { "$type": "dimension", "$value": "24px", "$description": "Target corner radius passed to concentric focus on dropdown options." },
    "pill": { "$type": "dimension", "$value": "9999px", "$description": "Full capsule (height / 2)." }
  },
  "spacing": {
    "pageMarginX": { "$type": "dimension", "$value": "44px" },
    "headerTop": { "$type": "dimension", "$value": "36px" },
    "contentTop": { "$type": "dimension", "$value": "150px" },
    "columnGap": { "$type": "dimension", "$value": "30px" },
    "groupGap": { "$type": "dimension", "$value": "36px", "$description": "Vertical gap between group cards on full-screen pages (CpGap)." },
    "groupGapSheet": { "$type": "dimension", "$value": "32px", "$description": "Vertical gap between group cards on modal sheets (RsGap)." },
    "cardPadding": { "$type": "dimension", "$value": "30px" },
    "rowPaddingX": { "$type": "dimension", "$value": "44px" },
    "rowHeight": { "$type": "dimension", "$value": "112px" },
    "rowHeightSub": { "$type": "dimension", "$value": "140px" },
    "rowHeightSlider": { "$type": "dimension", "$value": "160px" },
    "rowHeightSheet": { "$type": "dimension", "$value": "136px" },
    "optionHeight": { "$type": "dimension", "$value": "88px" },
    "optionHeightCompact": { "$type": "dimension", "$value": "62px" },
    "dividerGrooveTotal": { "$type": "dimension", "$value": "4px", "$description": "2.5px #E1E2E7 + 1.5px #FFFFFF." },
    "chipGap": { "$type": "dimension", "$value": "14px" },
    "scrollSafetyMargin": { "$type": "dimension", "$value": "60px", "$description": "Top/bottom auto-scroll margin around focused row." }
  },
  "elevation": {
    "card3d": {
      "$description": "Dual-layer shadow for CpCard (3D container): ambient soft drop + crisp contact shadow.",
      "drop": { "offsetX": "4px", "offsetY": "12px", "insetX": "4px", "blur": "14px", "alpha": 0.20, "color": "#000000" },
      "contact": { "offsetX": "0px", "offsetY": "2px", "insetX": "0px", "blur": "3px", "alpha": 0.10, "color": "#000000" }
    },
    "groupSheet": { "offsetX": "0px", "offsetY": "5px", "blur": "6px", "alpha": 0.16, "color": "#000000" },
    "optionCard": { "offsetX": "0px", "offsetY": "5px", "blur": "8px", "alpha": 0.18, "color": "#000000" },
    "dialog": { "offsetX": "0px", "offsetY": "12px", "blur": "22px", "alpha": 0.35, "color": "#000000" },
    "pill": { "offsetX": "0px", "offsetY": "3px", "blur": "6px", "alpha": 0.14, "color": "#000000" },
    "toggleKnob": { "offsetX": "0px", "offsetY": "3px", "blur": "4px", "alpha": 0.22, "color": "#000000" },
    "sliderThumb": { "offsetX": "0px", "offsetY": "3px", "blur": "5px", "alpha": 0.30, "color": "#000000" },
    "primaryActionGlow": { "offsetX": "0px", "offsetY": "8px", "blur": "9px", "alpha": 0.45, "color": "#7A3CFF" },
    "backdropBlur": { "$type": "dimension", "$value": "8px", "$description": "Gaussian sigma applied to background UI components layer (never wallpaper) when modal/drawer opens." }
  },
  "focus": {
    "thicknessScale": { "$type": "number", "$value": 0.6, "$description": "RwThick multiplier applied to stroke width and outset padding." },
    "strokeWidthDp": { "$type": "number", "$value": 4.8, "$description": "8 dp * 0.6 = 4.8 dp (8.4 px on 1920x1200)." },
    "glowStrokeMultiplier": { "$type": "number", "$value": 2.0 },
    "glowBlurDp": { "$type": "number", "$value": 3.5, "$description": "7 dp / 2 Gaussian blur sigma." },
    "rimStrokeExpandDp": { "$type": "number", "$value": 2.0, "$description": "Outer rim ring width (+/- 2 dp around main stroke, #FAFAFA @ 40%)." },
    "outsetMinDp": { "$type": "number", "$value": 5.0 },
    "outsetMaxDp": { "$type": "number", "$value": 24.0 },
    "outsetRatio": { "$type": "number", "$value": 0.12, "$description": "outset = clamp(0.12 * min(w, h), 5dp, 24dp) * thicknessScale." },
    "concentricRadiusRule": { "$type": "string", "$value": "targetRadius + outset / 2" },
    "legBaseDp": { "$type": "number", "$value": 18.0 },
    "gapBaseDp": { "$type": "number", "$value": 14.0 },
    "gapMaxRatio": { "$type": "number", "$value": 0.36 },
    "scaleFactorRefDp": { "$type": "number", "$value": 96.0 },
    "scaleFactorMin": { "$type": "number", "$value": 0.35 },
    "scaleFactorMax": { "$type": "number", "$value": 1.75 },
    "ringIcon": {
      "radiusPx": { "$type": "dimension", "$value": "36px" },
      "arcSpanDeg": { "$type": "number", "$value": 52, "$description": "4 arcs of 52 deg each, separated by 38 deg gaps at cardinal directions." },
      "gapDeg": { "$type": "number", "$value": 38 }
    },
    "flowPeriodMs": { "$type": "duration", "$value": "1800ms", "$description": "Global constant perimeter flow revolution period regardless of box perimeter." }
  },
  "motion": {
    "spring": {
      "$description": "Critically damped springs (dampingRatio = 1.0). Natural angular frequency omega = sqrt(stiffness). In WinUI Composition, Period = 1 / sqrt(stiffness) seconds.",
      "focus": { "stiffness": 600, "dampingRatio": 1.0 },
      "rowScroll": { "stiffness": 1500, "dampingRatio": 1.0 },
      "navSelected": { "stiffness": 1500, "dampingRatio": 1.0 },
      "drawerOpenX": { "stiffness": 4200, "dampingRatio": 1.0 },
      "drawerOpenY": { "stiffness": 1250, "dampingRatio": 1.0, "delayMs": 30 },
      "drawerCloseY": { "stiffness": 2600, "dampingRatio": 1.0 },
      "drawerCloseX": { "stiffness": 5200, "dampingRatio": 1.0, "delayMs": 50 }
    },
    "easing": {
      "slideOut": { "$type": "cubicBezier", "$value": [0.22, 1.0, 0.36, 1.0] },
      "drawerIn": { "$type": "cubicBezier", "$value": [0.2, 0.8, 0.2, 1.0] },
      "drawerOut": { "$type": "cubicBezier", "$value": [0.4, 0.0, 0.6, 1.0] },
      "stretchPeak": { "$type": "cubicBezier", "$value": [0.3, 0.0, 0.4, 1.0] },
      "inertiaDecel": { "$type": "cubicBezier", "$value": [0.15, 0.7, 0.25, 1.0] }
    },
    "duration": {
      "instant": { "$type": "duration", "$value": "1ms" },
      "cursorHide": { "$type": "duration", "$value": "60ms" },
      "dialogIn": { "$type": "duration", "$value": "80ms" },
      "pillExpand": { "$type": "duration", "$value": "150ms" },
      "toggleSlide": { "$type": "duration", "$value": "150ms" },
      "navCrossfade": { "$type": "duration", "$value": "150ms" },
      "relayoutSlide": { "$type": "duration", "$value": "170ms" },
      "drawerSlide": { "$type": "duration", "$value": "200ms" },
      "backdropBlur": { "$type": "duration", "$value": "230ms" },
      "rubberband": { "$type": "duration", "$value": "230ms" },
      "toastLifetime": { "$type": "duration", "$value": "2400ms" }
    },
    "stagger": {
      "sheetRowMs": { "$type": "duration", "$value": "33ms" },
      "leftDrawerRowMs": { "$type": "duration", "$value": "55ms", "offsetX": "14px" }
    },
    "rubberband": {
      "maxScale": { "$type": "number", "$value": 1.45, "$description": "1 + min(0.45, distance / axisSize * 0.35), peaks at t = 0.3 of 230ms." },
      "distanceRatio": { "$type": "number", "$value": 0.35 },
      "peakProgress": { "$type": "number", "$value": 0.3 },
      "overscrollResistance": { "$type": "number", "$value": 0.3333, "$description": "Touch overscroll moves 1/3 of finger drag beyond bounds." }
    }
  }
}
