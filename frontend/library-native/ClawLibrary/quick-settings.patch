+            int osd = Bool(QsGet("osd.enabled", d)) ? (int)QsNum("osd.level", 1, d) : 0;
+            Tile("osd", "", "性能显示", osd == 0 ? "关" : $"{osd} 档", osd > 0);
+        }
+        double fps = QsNum("system.fpsLimit");
+        Tile("fps", "", "限帧", fps > 0 ? $"{fps:0} 帧" : "不限", fps > 0, QsGet("system.fpsLimit") == null);
+        double hz = QsNum("system.refresh");
