+    }
+
+    private void QsDrawItem(CanvasDrawingSession ds, QsItem it, bool focus)
+    {
+        var text = it.Disabled ? Gfx.WithAlpha(CcText, 0.35) : CcText;
+        switch (it.Kind)
+        {
+            case QsKind.Slider:
+            {
+                if (focus) ds.FillRoundedRectangle(it.X, it.Y, it.W, it.H, 10, 10, QsChip);
+                float cy = it.Y + it.H / 2, x0 = it.X + 52, x1 = it.X + it.W - 70;
+                CcGlyph(ds, it.Glyph, it.X + 26, cy, 20, text);
+                ds.FillRoundedRectangle(x0, cy - 3, x1 - x0, 6, 3, 3, focus ? Gfx.Rgba(0x5a, 0x60, 0x6a) : QsChip);
+                if (!it.Disabled)
+                {
+                    float fx = x0 + (x1 - x0) * it.Level;
+                    ds.FillRoundedRectangle(x0, cy - 3, Math.Max(6, fx - x0), 6, 3, 3, QsAccent);
+                    ds.FillCircle(fx, cy, focus ? 9 : 7, CcText);
+                }
+                using var vl = TextKit.Layout(ds, it.Value, TextKit.Num(600), 15, 56, CanvasHorizontalAlignment.Right);
+                ds.DrawTextLayout(vl, it.X + it.W - 12 - 56, cy - (float)vl.LayoutBounds.Height / 2 - (float)vl.LayoutBounds.Y, text);
+                break;
+            }
+            case QsKind.Tile:
+            {
+                ds.FillRoundedRectangle(it.X, it.Y, it.W, it.H, 12, 12, focus ? QsChipFocus : QsChip);
+                if (focus) ds.DrawRoundedRectangle(it.X + 1, it.Y + 1, it.W - 2, it.H - 2, 11, 11, CcText, 2);
+                var icon = it.Disabled ? text : it.On ? QsAccent : CcText;
+                CcGlyph(ds, it.Glyph, it.X + 24, it.Y + 24, 20, icon);
+                using (var nl = TextKit.Layout(ds, it.Name, TextKit.Ui(500), 13, it.W - 24, CanvasHorizontalAlignment.Left))
+                    ds.DrawTextLayout(nl, it.X + 14 - (float)nl.LayoutBounds.X, it.Y + 44 - (float)nl.LayoutBounds.Y, Gfx.WithAlpha(text, 0.7));
+                using (var vl = TextKit.Layout(ds, it.Value, TextKit.Ui(600), 15, it.W - 24, CanvasHorizontalAlignment.Left))
+                {
+                    vl.Options = CanvasDrawTextOptions.Clip;
+                    vl.TrimmingSign = CanvasTrimmingSign.Ellipsis;
+                    vl.TrimmingGranularity = CanvasTextTrimmingGranularity.Character;
+                    ds.DrawTextLayout(vl, it.X + 14 - (float)vl.LayoutBounds.X, it.Y + 62 - (float)vl.LayoutBounds.Y, it.Disabled ? text : it.On ? QsAccent : CcText);
+                }
+                break;
+            }
+            default:
+            {
+                ds.FillRoundedRectangle(it.X, it.Y, it.W, it.H, it.H / 2, it.H / 2, focus ? CcText : QsChip);
+                var fg = focus ? Gfx.Rgba(0x12, 0x14, 0x17) : CcText;
+                using var nl = TextKit.Layout(ds, it.Name, TextKit.Ui(600), 15, it.W, CanvasHorizontalAlignment.Left);
+                float total = 20 + 8 + (float)nl.LayoutBounds.Width, sx = it.X + (it.W - total) / 2, cy = it.Y + it.H / 2;
+                CcGlyph(ds, it.Glyph, sx + 10, cy, 18, fg);
+                ds.DrawTextLayout(nl, sx + 28 - (float)nl.LayoutBounds.X, cy - (float)nl.LayoutBounds.Height / 2 - (float)nl.LayoutBounds.Y, fg);
+                break;
+            }
+        }
+    }
+
+    // ---------------- 逐帧：进出场 + 缩略图 ----------------
+
+    private void QsStartTicking()
+    {
+        _qsFrameAt = NowMs;
+        if (_qsTicking) { QsLayout(); return; }
+        _qsTicking = true;
+        Microsoft.UI.Xaml.Media.CompositionTarget.Rendering += QsFrame;
+        QsLayout();
+    }
+
+    private void QsFrame(object? sender, object e)
+    {
+        long now = NowMs;
+        float dt = Math.Clamp((now - _qsFrameAt) / 1000f, 0, 0.05f);
+        _qsFrameAt = now;
+        _qsShow += (_qsShowTo - _qsShow) * (1 - MathF.Exp(-dt * (_qsShowTo > _qsShow ? 13 : 16)));
+        bool settled = MathF.Abs(_qsShowTo - _qsShow) < 0.002f;
+        if (settled) _qsShow = _qsShowTo;
+        QsLayout();
+        if (!settled) return;
+        Microsoft.UI.Xaml.Media.CompositionTarget.Rendering -= QsFrame;
+        _qsTicking = false;
+        if (!_qsOpen && _qsShow <= 0) QsFinishClose();
+    }
+
+    /// <summary>面板 X（设计 px）= -464 → 0；游戏缩略图只画面板右边那一块，位置和游戏窗口原来一样。</summary>
+    private void QsLayout()
+    {
+        if (_qs == null) return;
+        float k = _ccK > 0 ? _ccK : (float)(View.Width / 1280), dpi = Chrome.Dpi;
+        float ease = 1 - MathF.Pow(1 - _qsShow, 3);
+        float x = -QsW + QsW * ease;
+        _qsPanel.Offset = new Vector3(x * k, 0, 0);
+        _qsPanel.Opacity = _qsShow > 0.001f ? 1 : 0;   // 从屏幕外滑进来，不淡入（淡入那几帧露出的是黑底）
+        _qsScrim.Opacity = _qsThumb != null ? 1 : ease;
+        if (_qsThumb is not { } th) return;
+        int edge = (int)MathF.Round((x + QsW) * k * dpi);
+        var (gl, gt, gw, gh) = _qsGameRect;
+        int left = Math.Max(edge, gl), right = gl + gw;
+        if (right <= left) { th.PlaceCropped(0, 0, 0, 0, 0, 0, 0, 0); return; }
+        double sx = (double)th.SourceW / gw, sy = (double)th.SourceH / gh;
+        th.PlaceCropped(left, gt, right - left, gh, (int)Math.Round((left - gl) * sx), 0, (int)Math.Round((right - left) * sx), (int)Math.Round(gh * sy));
+    }
+
+    // ---------------- 输入 ----------------
+
+    private void QsMove(Direction dir)
+    {
+        var cur = _qsItems[_qsFocus];
+        if (cur.Kind == QsKind.Slider && dir is Direction.Left or Direction.Right) { QsNudge(cur, dir == Direction.Right ? 1 : -1); return; }
+        // 按位置找：这个方向上中心最近的一项（横向走同一行，竖向走离得最近的一行）
+        float cx = cur.X + cur.W / 2, cy = cur.Y + cur.H / 2;
+        int best = -1; float bestScore = float.MaxValue;
+        for (int i = 0; i < _qsItems.Count; i++)
+        {
+            if (i == _qsFocus) continue;
+            var it = _qsItems[i];
+            float ix = it.X + it.W / 2, iy = it.Y + it.H / 2, dx = ix - cx, dy = iy - cy;
+            bool ok = dir switch { Direction.Up => dy < -1, Direction.Down => dy > 1, Direction.Left => dx < -1 && MathF.Abs(dy) < 4, _ => dx > 1 && MathF.Abs(dy) < 4 };
+            if (!ok) continue;
+            float score = dir is Direction.Up or Direction.Down ? MathF.Abs(dy) * 4 + MathF.Abs(dx) : MathF.Abs(dx);
+            if (score < bestScore) { bestScore = score; best = i; }
+        }
+        if (best < 0) { Cue(Sfx.Bump); return; }
+        _qsFocus = best;
+        _qsFocusId = _qsItems[best].Id;
+        Cue(Sfx.Nav);
+        QsPaint();
+    }
+
+    /// <summary>滑条 ← →：亮度、音量 5 一格，功耗 1 W 一格。马上发给后台，本地先动。</summary>
+    private void QsNudge(QsItem it, int d)
+    {
+        if (it.Disabled) { Cue(Sfx.Bump); return; }
+        switch (it.Id)
+        {
+            case "brightness" or "volume":
+            {
+                string path = it.Id == "brightness" ? "brightness" : "volume";
+                double v = Math.Clamp(Math.Round(QsNum("system." + path) / 5) * 5 + d * 5, 0, 100);
+                if (_qsState?["system"] is JsonObject sys) { sys[path] = v; if (it.Id == "volume") sys["muted"] = false; }
+                Cue(d > 0 ? Sfx.SliderUp : Sfx.SliderDown);
+                _ = QsCall("", it.Id == "brightness" ? "set_brightness" : "set_volume", JsonValue.Create(v));
+                _qsNote = null;
+                break;
+            }
+            case "tdp":
+            {
+                if (_qsDraft?["manual"] is not JsonObject manual) return;
+                var (lo, hi) = QsTdpRange();
+                double v = Math.Clamp(QsNum("tdp", lo, manual) + d, lo, hi);
+                manual["tdp"] = v;
+                Cue(d > 0 ? Sfx.SliderUp : Sfx.SliderDown);
+                _ = QsSavePower($"功耗 {v:0} W");
+                break;
+            }
+        }
+        QsBuild();
+        QsPaint();
+    }
+
+    private void QsActivate()
+    {
+        var it = _qsItems[_qsFocus];
+        if (it.Disabled) { Cue(Sfx.Bump); return; }
+        var d = _qsDraft;
+        switch (it.Id)
+        {
+            case "volume":
+            {
+                bool muted = !Bool(QsGet("system.muted"));
+                if (_qsState?["system"] is JsonObject sys) sys["muted"] = muted;
+                _ = QsCall(muted ? "已静音" : "取消静音", "set_mute", JsonValue.Create(muted));
+                break;
+            }
+            case "brightness" or "tdp": QsNudge(it, 1); return;
+            case "power" when d != null:
+            {
+                // 系统控制 → 智能 → 快捷档位（几瓦）… → 系统控制，和小组件的「功耗」磁贴同一个循环
+                var quick = (d["quick"] as JsonArray)?.Select(n => n is JsonValue v && v.TryGetValue(out double x) ? x : 0).Where(x => x > 0).ToList() ?? new();
+                bool enabled = Bool(d["enabled"]);
+                string mode = Str(d["mode"]) ?? "";
+                double tdp = QsNum("manual.tdp", 0, d);
+                int at = quick.IndexOf(tdp);
+                int index = !enabled ? 0 : mode == "autotdp" ? 1 : mode == "manual" && at >= 0 ? 2 + at : 1;
+                int next = (index + 1) % (quick.Count + 2);
+                string note;
+                if (next == 0) { d["enabled"] = false; note = "性能：系统控制"; }
+                else if (next == 1) { d["enabled"] = true; d["mode"] = "autotdp"; note = "性能：智能"; }
+                else
+                {
+                    d["enabled"] = true; d["mode"] = "manual";
+                    if (d["manual"] is not JsonObject m) { m = new JsonObject(); d["manual"] = m; }
+                    m["tdp"] = quick[next - 2];
+                    note = $"性能：{quick[next - 2]:0} W";
+                }
+                _ = QsSavePower(note);
+                break;
+            }
+            case "fan" when d != null:
+            {
+                string cur = Str(QsGet("fan.mode", d)) ?? "";
+                int i = Array.FindIndex(QsFan, f => f.Id == cur);
+                var next = QsFan[(i + 1) % QsFan.Length];
+                if (d["fan"] is not JsonObject fan) { fan = new JsonObject(); d["fan"] = fan; }
+                fan["mode"] = next.Id;
+                _ = QsSavePower("风扇：" + next.N);
+                break;
+            }
+            case "osd" when d != null:
+            {
+                int cur = Bool(QsGet("osd.enabled", d)) ? (int)QsNum("osd.level", 1, d) : 0, next = (cur + 1) % 5;
+                if (d["osd"] is not JsonObject osd) { osd = new JsonObject(); d["osd"] = osd; }
+                osd["enabled"] = next > 0;
+                if (next > 0) osd["level"] = next;
+                _ = QsSavePower(next == 0 ? "性能显示：关" : $"性能显示：{next} 档");
+                break;
+            }
+            case "fps":
+            {
+                double cur = QsNum("system.fpsLimit");
+                int i = Array.FindIndex(QsFps, f => f == (int)cur);
+                int next = QsFps[(i + 1) % QsFps.Length];
+                if (_qsState?["system"] is JsonObject sys) sys["fpsLimit"] = next;
+                _ = QsCall(next > 0 ? $"限帧：{next} 帧" : "限帧：不限", "set_fps_limit", JsonValue.Create(next));
+                break;
+            }
+            case "refresh":
+            {
+                var rates = QsRefreshRates();
+                double cur = QsNum("system.refresh");
+                double next = rates[(rates.IndexOf(cur) + 1) % rates.Count];
+                if (_qsState?["system"] is JsonObject sys) sys["refresh"] = next;
+                _ = QsCall($"刷新率：{next:0} Hz", "set_refresh_rate", JsonValue.Create(next));
+                break;
+            }
+            case "magpie":
+            {
+                bool on = !Bool(QsGet("magpie.enabled"));
+                if (_qsState?["magpie"] is JsonObject mg) mg["enabled"] = on;
+                _ = QsCall(on ? "画面缩放：开" : "画面缩放：关", "toggle_magpie");
+                break;
+            }
+            case "lossless":
+            {
+                bool on = _qsLossless != true;
+                _qsLossless = on;
+                _ = QsCall(on ? "小黄鸭：开" : "小黄鸭：关", "set_lossless_running", JsonValue.Create(on));
+                break;
+            }
+            case "rumble":
+            {
+                double cur = QsGet("rumble.strength") != null ? QsNum("rumble.strength") : 100;
+                int i = Array.FindIndex(QsRumble, r => r.V == QsRumble.OrderBy(x => Math.Abs(x.V - cur)).First().V);
+                var next = QsRumble[(i + 1) % QsRumble.Length];
+                if (_qsState?["rumble"] is JsonObject ru) ru["strength"] = next.V;
+                _ = QsCall("震动：" + next.N, "set_rumble_strength", JsonValue.Create(next.V));
+                break;
+            }
+            case "keyboard":
+                CloseQuickPanel();
+                _ = QsCall("", "toggle_keyboard");
+                return;
+            case "screenshot":
+                // 先收起面板再截，截到的是游戏
+                CloseQuickPanel();
+                After(500, () => _ = QsCall("", "screenshot"));
+                return;
+            case "wifi" or "bluetooth":
+                _ = QsRadio(it.Id == "wifi" ? RadioKind.WiFi : RadioKind.Bluetooth);
+                break;
+            case "windows":
+                CloseQuickPanel(hideWindow: false, instant: true);
+                OpenSwitcherFromAnywhere();
+                return;
+            case "mode":
+                CloseQuickPanel(hideWindow: false, instant: true);
+                _ = CcSwitchMode();
+                return;
+            case "sleep":
+                CloseQuickPanel(hideWindow: false, instant: true);
+                After(300, () => SystemInfo.Sleep(WinRT.Interop.WindowNative.GetWindowHandle(_window)));
+                return;
+        }
+        Cue(Sfx.Activate);
+        QsBuild();
+        QsPaint();
+    }
+
+    private async Task QsRadio(RadioKind kind)
+    {
+        string name = kind == RadioKind.WiFi ? "Wi-Fi" : "蓝牙";
+        try
+        {
+            if (await Radio.RequestAccessAsync() != RadioAccessStatus.Allowed) { QsFlash($"{name}：没有权限"); return; }
+            foreach (var r in await Radio.GetRadiosAsync())
+            {
+                if (r.Kind != kind) continue;
+                bool on = r.State != RadioState.On;
+                if (kind == RadioKind.WiFi) _qsWifi = on; else _qsBt = on;
+                QsBuild(); QsPaint();
+                var result = await r.SetStateAsync(on ? RadioState.On : RadioState.Off);
+                QsFlash(result == RadioAccessStatus.Allowed ? $"{name}：{(on ? "开" : "关")}" : $"{name}：没有切换");
+                break;
+            }
+        }
+        catch (Exception ex) { QsFlash($"{name}：{ex.Message}"); }
+        _ = QsRefresh(_qsVersion);
+    }
+
+    private void QsClick(double sx, double sy)
+    {
+        float k = _ccK > 0 ? _ccK : (float)(View.Width / 1280);
+        double x = sx / k, y = sy / k;
+        if (x > QsW) { CloseQuickPanel(); return; }   // 点到游戏那边 = 收起
+        for (int i = 0; i < _qsItems.Count; i++)
+        {
+            var it = _qsItems[i];
+            if (x < it.X || x > it.X + it.W || y < it.Y || y > it.Y + it.H) continue;
+            _qsFocus = i; _qsFocusId = it.Id;
+            if (it.Kind == QsKind.Slider && !it.Disabled && it.Id != "volume")
+            {
+                // 点滑条：直接定到点的位置
+                float x0 = it.X + 52, x1 = it.X + it.W - 70;
+                float level = (float)Math.Clamp((x - x0) / (x1 - x0), 0, 1);
+                QsSetLevel(it, level);
+                return;
+            }
+            QsActivate();
+            return;
+        }
+    }
+
+    private void QsSetLevel(QsItem it, float level)
+    {
+        if (it.Id is "brightness")
+        {
+            double v = Math.Round(level * 100);
+            if (_qsState?["system"] is JsonObject sys) sys["brightness"] = v;
+            _ = QsCall("", "set_brightness", JsonValue.Create(v));
+        }
+        else if (it.Id == "tdp" && _qsDraft?["manual"] is JsonObject manual)
+        {
+            var (lo, hi) = QsTdpRange();
+            double v = Math.Round(lo + (hi - lo) * level);
+            manual["tdp"] = v;
+            _ = QsSavePower($"功耗 {v:0} W");
+        }
+        QsBuild(); QsPaint();
+    }
+
+    /// <summary>自测用（--state=qs）：在游戏库里打开快捷设置，挨个走一遍焦点。</summary>
+    internal void QuickPanelTest(int steps)
+    {
+        if (!_qsOpen) OpenQuickPanel(0);
+        for (int i = 0; i < steps; i++) { int s = i; After(300 * (s + 1), () => { if (_qsOpen) QsMove(s % 6 < 3 ? Direction.Down : Direction.Right); }); }
+    }
+
+    internal void QuickPanelTestClose() => CloseQuickPanel(hideWindow: false);
+
+    /// <summary>自测用（--state=qsapply）：焦点放到某个磁贴上按一次 A，日志里记下按之前 / 之后后台报的值。</summary>
+    internal void QuickPanelTestPress(string id)
+    {
+        int i = _qsItems.FindIndex(it => it.Id == id);
+        if (i < 0) { Log.Info($"quick panel test: no {id}"); return; }
+        string before = _qsItems[i].Value;
+        _qsFocus = i; _qsFocusId = id;
+        QsActivate();
+        int j = _qsItems.FindIndex(it => it.Id == id);
+        Log.Info($"quick panel test press {id}: {before} -> {(j >= 0 ? _qsItems[j].Value : "?")}");
+    }
+
+    internal string QuickPanelTestValue(string id) => _qsItems.FirstOrDefault(it => it.Id == id)?.Value ?? "?";
+
+    [StructLayout(LayoutKind.Sequential)] private struct QsRect { public int Left, Top, Right, Bottom; }
+    [DllImport("user32.dll")] private static extern bool GetWindowRect(nint hwnd, out QsRect r);
+
+}
