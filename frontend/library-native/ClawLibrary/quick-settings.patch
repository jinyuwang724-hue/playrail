@@ -0,0 +1,732 @@
+// 快捷设置（快速设置键）：从左边滑出一列，像 Steam 大屏幕左边的主菜单那样竖着排；内容是 Game Bar 小组件那一套（同样的磁贴和后台调用）。
+// 游戏不切走：游戏库窗口到前台，但游戏的画面用 DWM 实时缩略图铺在面板右边（按游戏窗口原来的位置裁），看上去面板压在游戏上。
+// 面板（宽 464，#25282C，磁贴 #3E434B，强调 #4CC2FF）：
+//   标题（当前游戏名 / 快捷设置）
+//   亮度、音量（A 静音）、手动功耗时多一条功耗
+//   磁贴 3 列：性能、风扇、限帧、刷新率、性能显示、画面缩放 / 小黄鸭（只在游戏里）、震动、键盘、截图、Wi-Fi、蓝牙
+//   底部一排：窗口、切换到桌面 / 返回游戏模式、睡眠
+// 方向键按位置走（磁贴是网格），A 立即生效，滑条 ← → 调，B 或再按快速设置键收起。进出场是同一个逐帧趋近（可打断），缩略图同一帧跟着面板边缘走。
+using System.Numerics;
+using System.Runtime.InteropServices;
+using System.Text.Json.Nodes;
+using ClawLibrary.Data;
+using ClawLibrary.Engine;
+using Microsoft.Graphics.Canvas;
+using Microsoft.Graphics.Canvas.Text;
+using Microsoft.UI.Composition;
+using Windows.Devices.Radios;
+using Windows.UI;
+
+namespace ClawLibrary.Stage;
+
+public sealed partial class WallStage
+{
+    private enum QsKind { Slider, Tile, Entry }
+
+    private sealed class QsItem
+    {
+        public required string Id;
+        public required QsKind Kind;
+        public string Name = "", Value = "", Glyph = "";
+        public bool On, Disabled;
+        public float X, Y, W, H;
+        /// <summary>滑条 0–1。</summary>
+        public float Level;
+    }
+
+    private const float QsW = 464, QsPad = 24, QsTileH = 84, QsTileGap = 10, QsSliderH = 50, QsEntryH = 56;
+    private static readonly Color QsBg = Gfx.Rgba(0x25, 0x28, 0x2c), QsChip = Gfx.Rgba(0x3e, 0x43, 0x4b), QsChipFocus = Gfx.Rgba(0x4c, 0x52, 0x5c), QsAccent = Gfx.Rgba(0x4c, 0xc2, 0xff);
+    private static readonly int[] QsFps = { 0, 30, 40, 45, 60, 90, 120 };
