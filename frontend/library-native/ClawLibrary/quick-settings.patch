+            {
+                tl.Options = CanvasDrawTextOptions.Clip;
+                tl.TrimmingSign = CanvasTrimmingSign.Ellipsis;
+                tl.TrimmingGranularity = CanvasTextTrimmingGranularity.Character;
+                ds.DrawTextLayout(tl, QsPad - (float)tl.LayoutBounds.X, 34 - (float)tl.LayoutBounds.Y, CcText);
+            }
+            for (int i = 0; i < _qsItems.Count; i++) QsDrawItem(ds, _qsItems[i], i == _qsFocus);
+            if (_qsNote != null)
+            {
+                using var nl = TextKit.Layout(ds, _qsNote, TextKit.Ui(500), 14, QsW - 2 * QsPad, CanvasHorizontalAlignment.Left);
+                float nw = (float)nl.LayoutBounds.Width + 28, ny = _qsEntryY + QsEntryH + 18;
