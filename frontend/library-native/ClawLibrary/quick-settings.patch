+            QsSlider("tdp", "", $"{tdp:0} W", (float)((tdp - lo) / Math.Max(1, hi - lo)), false, ref y);
+        }
+        y += 8;
+        // 磁贴
+        var tiles = new List<QsItem>();
+        void Tile(string id, string glyph, string name, string value, bool on = false, bool disabled = false) =>
