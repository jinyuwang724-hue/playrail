+    // ---------------- 绘制 ----------------
+
+    private void QsPaint()
+    {
+        if (_qs == null) return;
+        float k = _ccK > 0 ? _ccK : (float)(View.Width / 1280), raster = k * Chrome.Dpi;
+        float H = (float)(View.Height / k);
+        CcSet(_qsPanel, CcDraw(QsW, H, raster, ds =>
+        {
+            ds.FillRectangle(0, 0, QsW, H, QsBg);
+            ds.FillRectangle(QsW - 1, 0, 1, H, Gfx.Rgba(255, 255, 255, 0.06));
