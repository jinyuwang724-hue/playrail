+    private void QsFlash(string text)
+    {
+        _qsNote = text;
+        _qsNoteAt = NowMs;
+        QsPaint();
+        long at = _qsNoteAt;
+        After(1800, () => { if (_qsNoteAt == at) { _qsNote = null; if (_qsOpen) QsPaint(); } });
+    }
