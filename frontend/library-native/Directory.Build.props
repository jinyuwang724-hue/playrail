<Project>
  <!-- 工作树路径很深，WinAppSDK 自包含会解出很长的文件名，超过 260 字符就复制失败：中间目录压短。 -->
  <PropertyGroup>
    <BaseIntermediateOutputPath>$(MSBuildThisFileDirectory)o\</BaseIntermediateOutputPath>
    <BaseOutputPath>$(MSBuildThisFileDirectory)b\</BaseOutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
  </PropertyGroup>
</Project>
